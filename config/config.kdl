// Phantom Theme & Layout for Zellij (Ghostty Style)
theme "phantom"

themes {
    phantom {
        fg "#e0e0e0"
        bg "#121212"
        black "#1c1c1c"
        red "#ff5555"
        green "#50fa7b"
        yellow "#f1fa8c"
        blue "#bd93f9"
        magenta "#ff79c6"
        cyan "#8be9fd"
        white "#f8f8f2"
        orange "#ffb86c"
    }
}

// Matikan pop-up Release Notes yang mengganggu di tengah skrin
show_release_notes false

// Layout bersih ala Ghostty (borderless panes)
default_layout "phantom"
pane_frames false
simplified_ui false

// Tetapan Interaksi & Tetikus
mouse_mode true
copy_on_select true
copy_command "wl-copy"
session_name "phantom"

// Performance & Auto Layout
auto_layout true
session_serialization true
serialize_pane_viewport true

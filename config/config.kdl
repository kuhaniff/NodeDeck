// Phantom: simple, flat, modern Zellij config
theme "phantom"
default_layout "phantom"

themes {
    phantom {
        // Body text and unselected panes
        text_unselected {
            base 216 220 228
            background 15 17 21
            emphasis_0 224 175 104
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        text_selected {
            base 216 220 228
            background 42 51 80
            emphasis_0 224 175 104
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        // Tab bar: inactive tabs are quiet, the active tab is a blue pill
        ribbon_unselected {
            base 169 176 192
            background 26 29 35
            emphasis_0 224 175 104
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        ribbon_selected {
            base 15 17 21
            background 122 162 247
            emphasis_0 247 118 142
            emphasis_1 224 175 104
            emphasis_2 15 17 21
            emphasis_3 187 154 247
        }
        frame_selected {
            base 122 162 247
        }
        frame_unselected {
            base 42 51 80
        }
    }
}

// No popups on startup
show_startup_tips false
show_release_notes false

// Flat UI: no powerline arrows, no pane borders
simplified_ui true
pane_frames false

// Mouse
mouse_mode true
copy_on_select true
// copy_command intentionally unset: Zellij then copies via OSC 52,
// which is what reaches the browser clipboard

// Sessions
session_serialization true
pane_viewport_serialization true

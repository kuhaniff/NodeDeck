// Phantom Ghostty Theme & Config
theme "ghostty"

themes {
    ghostty {
        fg "#e0e0e0"
        bg "#121212"
        black "#1c1c1c"
        red "#ff5555"
        green "#50fa7b"
        yellow "#f1fa8c"
        blue "#bd93f9"
        magenta "#ff79c6"
        cyan "#8be9fd"
        white "#f8f8f2"
        orange "#ffb86c"
    }
}

// Matikan pop-up tips & release notes mengganggu
show_startup_tips false
show_release_notes false

// Ghostty style: Borderless, simple tab bar & status
default_layout "phantom"
pane_frames false
simplified_ui false

// Tetikus & Interaksi
mouse_mode true
copy_on_select true
copy_command "wl-copy"

// Performance
auto_layout true
session_serialization true
serialize_pane_viewport true
